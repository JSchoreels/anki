+    fn rwkv_state_precision_int8_matches_reference_at_ties_and_extreme_scales() {
+        // A 127 anchor fixes scale=1. Test every half-integer and both adjacent
+        // floats, including negative ties and values that must round to zero.
+        for integer in -127..127 {
+            let tie = integer as f32 + 0.5;
+            for value in [tie.next_down(), tie, tie.next_up()] {
+                let mut row = [value; HEAD_SIZE];
+                row[0] = 127.0;
+                assert_int8_matches_reference(&row);
+            }
+        }
+        for maximum in [0.0, f32::from_bits(1), f32::MIN_POSITIVE, f32::MAX] {
+            let row = std::array::from_fn::<_, HEAD_SIZE, _>(|i| match i % 4 {
+                0 => maximum,
+                1 => -maximum,
+                2 => 0.0,
+                _ => -0.0,
+            });
+            assert_int8_matches_reference(&row);
+        }
