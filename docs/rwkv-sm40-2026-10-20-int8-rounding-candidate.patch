+/// Encode one row and retain its codes for immediate in-place rounding.
+#[inline(always)]
+fn encode_int8_row(row: &[f32], out: &mut Vec<u8>) -> (f32, [u8; HEAD_SIZE]) {
+    let maximum = row.iter().map(|v| v.abs()).fold(0.0_f32, f32::max);
+    let scale = if maximum == 0.0 {
+        1.0
+    } else {
+        (maximum / 127.0).max(f32::from_bits(1))
+    };
+    let mut codes = [0; HEAD_SIZE];
+    for (code, value) in codes.iter_mut().zip(row) {
+        let value = (value / scale).clamp(-127.0, 127.0);
+        // 1.5 * 2^23 has unit ULP and a zero low byte. Adding a value in
+        // [-127, 127] rounds to nearest-even; the low byte is its signed code.
+        // This avoids per-element rounding calls and saturating float casts.
+        let rounded = (value + 12_582_912.0).to_bits() as u8;
+        *code = if value.is_nan() {
+            0 // Match the previous saturating float-to-int cast.
+        } else {
+            rounded
+        };
+    }
+    out.extend_from_slice(&scale.to_le_bytes());
+    out.extend_from_slice(&codes);
+    (scale, codes)
+}
