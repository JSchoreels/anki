+// Benchmark prototype: apply the same outlier decisions without expanding every
+// selected card prefix into an owned FSRSItem.
+pub(crate) fn filter_outlier_card_prefix_indices(
+    dataset_for_initialization: &[FSRSItem],
+    card_prefixes: &CardPrefixes,
+) -> (Vec<usize>, Vec<usize>) {
+    let decisions = compute_outlier_bucket_decisions(dataset_for_initialization.iter());
+    let train_indices = card_prefixes
+        .prefixes
+        .iter()
+        .enumerate()
+        .filter_map(|(index, &prefix)| {
+            let reviews = card_prefixes.reviews(prefix);
+            let first_long_term = reviews.iter().find(|review| review.delta_t >= 1.0);
+            let survives = first_long_term.is_none_or(|review| {
+                let key = bucket_long_term_delta_t(review.delta_t).to_bits();
+                !decisions.removed_pairs[reviews[0].rating as usize].contains(&key)
+            });
+            survives.then_some(index)
+        })
+        .collect();
+    (decisions.kept_initialization_indices, train_indices)
+}
