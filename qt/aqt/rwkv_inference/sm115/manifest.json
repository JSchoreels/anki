 "model": "the longer cool-down for Tiny (SM115)",
 "use": {
  "heads": [
   "instant",
   "rating"
  ],
  "rule": "instant-only model: the Tiny Instant-Only model (SM101)'s line (one card layer) distilled from the show-time instant-only big model (SM99) as teacher, with a two-epoch 32k Muon cool-down in two passes (curve_loss_weight 0.0, show-time inputs). Its instant / rating head (p_imm, p_rating) is the product; its curve head was never trained and must not schedule. In the Anki fork it is the 'Tiny' RWKV-Instant model: alone without RWKV-Curve, or beside the Tiny two-head model (SM106), which keeps the curve, intervals and S90.",
  "architecture": "w64-c1: the small model (w64) with 1 card layer instead of 2 (stream card_id n_layers 1, layer_steps without (0, 1)); every other stream and dimension unchanged"
 },
 "inputs": {
  "show_time_intervals": true,
  "rule": "trained with show-time intervals: the instant query row of review j and the curve query for review j use floor(max(elapsed_seconds_j - duration_j / 1000, 0)) seconds (previous answer to the moment review j is shown), its sin / cos, and the cumulative interval = the card's earlier answer-to-answer intervals + that show-time interval; update rows keep the answer-to-answer interval. The test vectors are built this way (testvectors/make_testvectors.py, the held-out scorer's --inputs e2s-query rows).",
  "leak_free": "RWKV_DELETED_CARDS=neighbour: missing-ID flags (features 13-15) always 0"
 },
