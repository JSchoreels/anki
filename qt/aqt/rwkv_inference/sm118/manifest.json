 "model": "the show-time two-head cool-down for Small (SM118)",
 "use": {
  "heads": [
   "curve",
   "instant",
   "rating"
  ],
  "rule": "two-head model: the show-time retrain (SM92)'s constant-LR epoch 26 with a two-epoch 32k Muon cool-down in two passes distilled from the show-time big model (SM91s2) (decay alpha 0.5, show-time inputs, both heads). Its curve head (p_curve, intervals, S90) and its instant / rating head (p_imm, p_rating) are both the product. In the Anki fork it is the 'Small' two-head model (release candidate 2026-11), in the show-time retrain (SM92)'s place; its answer-time head comes from the SM119 run (474 inputs).",
  "architecture": "w64: the small model (5 streams, d_model 64); same architecture and state as the show-time retrain (SM92)"
 },
 "inputs": {
  "show_time_intervals": true,
  "rule": "trained with show-time intervals: the instant query row of review j and the curve query for review j use floor(max(elapsed_seconds_j - duration_j / 1000, 0)) seconds (previous answer to the moment review j is shown), its sin / cos, and the cumulative interval = the card's earlier answer-to-answer intervals + that show-time interval; update rows keep the answer-to-answer interval. The test vectors are built this way (testvectors/make_testvectors.py, the held-out scorer's --inputs e2s-query rows).",
  "leak_free": "RWKV_DELETED_CARDS=neighbour: missing-ID flags (features 13-15) always 0"
 },
