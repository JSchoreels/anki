 "model": "the six-layer Tiny Instant-Only model (SM130)",
 "use": {
  "heads": [
   "instant",
   "rating"
  ],
  "rule": "instant-only model: the Tiny Instant-Only chain (SM101's constant-LR epoch 38) cut to six layer steps, 3 constant-LR recovery epochs (39-41, curve_loss_weight 0.0), then the longer cool-down for Tiny (SM115)'s two-pass 32k Muon cool-down with the show-time instant-only big model (SM99) as teacher. Its instant / rating head (p_imm, p_rating) is the product; its curve head was never trained and must not schedule. In the Anki fork it is the 'Tiny' RWKV-Instant model (release candidate 2026-11): alone without RWKV-Curve, or beside the six-layer Tiny two-head model (SM130), which keeps the curve, intervals and S90; its answer-time head (SM138) takes 346 inputs.",
  "architecture": "w64-c1-d2p1u1: the Tiny model (w64-c1, one card layer) with the trailing deck / preset / user layers cut (streams card 1, deck 2, note 1, preset 1, user 1 layers; layer_steps (0,0) (1,0) (2,0) (3,0) (4,0) (1,1), two interleaved rounds; channel mixers card 0, deck 0, note 0); every other dimension unchanged; 185,057 parameters (Tiny 311,786); same card and note state as Tiny"
 },
 "inputs": {
  "show_time_intervals": true,
  "rule": "trained with show-time intervals: the instant query row of review j and the curve query for review j use floor(max(elapsed_seconds_j - duration_j / 1000, 0)) seconds (previous answer to the moment review j is shown), its sin / cos, and the cumulative interval = the card's earlier answer-to-answer intervals + that show-time interval; update rows keep the answer-to-answer interval. The test vectors are built this way (testvectors/make_testvectors.py, the held-out scorer's --inputs e2s-query rows).",
  "leak_free": "RWKV_DELETED_CARDS=neighbour: missing-ID flags (features 13-15) always 0"
 },
