 "use": {
  "heads": [
   "curve",
   "instant",
   "rating"
  ],
  "rule": "two-head model: trained with both heads at the show-time retrain (SM92)'s loss weights and show_time_intervals, from SM92's epoch 26 cut to one card layer (epochs 27-29 + the release's one-epoch 32k Muon cool-down). Its curve head (p_curve, intervals, S90) and its instant / rating head (p_imm, p_rating) are both the product. It has no answer-time head (none was trained on its trunk). In the Anki fork it is the Tiny size's one-model choice: alone for both schedulers when the one-model opt-out is on.",
  "architecture": "w64-c1: the small model (w64) with 1 card layer instead of 2 (stream card_id n_layers 1, layer_steps without (0, 1)); every other stream and dimension unchanged"
 },
 "inputs": {
  "show_time_intervals": true,
  "rule": "trained with the track option show_time_intervals: the instant query row of review j and the curve query for review j use floor(max(elapsed_seconds_j - duration_j / 1000, 0)) seconds (previous answer to the moment review j is shown), its sin / cos, and the cumulative interval = the card's earlier answer-to-answer intervals + that show-time interval; update rows keep the answer-to-answer interval and the cumulative interval including it. The test vectors are built this way (testvectors/make_testvectors.py, the held-out scorer's --inputs e2s-query rows), as for sm92, sm98 and sm101.",
  "leak_free": "RWKV_DELETED_CARDS=neighbour: missing-ID flags (features 13-15) always 0 (INTEGRATION.md 6.9)"
 }
}