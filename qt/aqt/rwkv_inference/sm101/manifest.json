 "use": {
  "heads": [
   "instant",
   "rating"
  ],
  "rule": "instant-only model: trained with curve_loss_weight 0.0 and show_time_intervals from the show-time instant-only model, stage 2 (SM98)'s epoch 35 cut to one card layer (epochs 36-38 + the release's one-epoch 32k Muon cool-down). Its instant / rating head (p_imm, p_rating) is the product; its curve head was never trained and must not schedule. In the Anki fork it is the 'Tiny' RWKV-Instant model: alone without RWKV-Curve, or beside the release (sm72e25), which keeps the curve, intervals, S90 and the answer-time head.",
  "architecture": "w64-c1: the small model (w64) with 1 card layer instead of 2 (stream card_id n_layers 1, layer_steps without (0, 1)); every other stream and dimension unchanged"
 },
 "inputs": {
  "show_time_intervals": true,
  "rule": "trained with the track option show_time_intervals: the instant query row of review j and the curve query for review j use floor(max(elapsed_seconds_j - duration_j / 1000, 0)) seconds (previous answer to the moment review j is shown), its sin / cos, and the cumulative interval = the card's earlier answer-to-answer intervals + that show-time interval; update rows keep the answer-to-answer interval and the cumulative interval including it. The test vectors are built this way (testvectors/make_testvectors.py, the held-out scorer's --inputs e2s-query rows), as for sm92 and sm98.",
  "leak_free": "RWKV_DELETED_CARDS=neighbour: missing-ID flags (features 13-15) always 0 (INTEGRATION.md 6.9)"
 }
}